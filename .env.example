# Google Cloud 認証情報
# サービスアカウントキー(JSON)へのパスを指定してください
# 例: /Users/username/path/to/service-account-key.json
# 注: GOOGLE_APPLICATION_CREDENTIALS または KEY_FILE_PATH のいずれかを設定してください
GOOGLE_APPLICATION_CREDENTIALS=
KEY_FILE_PATH=

# Document AI 設定
# GCP プロジェクトID (必須)
PROJECT_ID=

# プロセッサの場所 (デフォルト: us)
# 例: us, eu, asia-northeast1 など
LOCATION=us

# Document AI プロセッサID (必須)
# GCP コンソールの Document AI ページで確認できます
PROCESSOR_ID=
