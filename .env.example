# Google Cloud 認証情報
# サービスアカウントキー(JSON)へのパスを指定してください
# 例: /Users/username/path/to/service-account-key.json
# 注: GOOGLE_APPLICATION_CREDENTIALS または KEY_FILE_PATH のいずれかを設定してください
GOOGLE_APPLICATION_CREDENTIALS=
KEY_FILE_PATH=

# GCP プロジェクトID (必須)
PROJECT_ID=

# Document AI 設定
LOCATION=us
PROCESSOR_ID=

# Cloud Storage設定
GCS_BUCKET_NAME=

# Pub/Sub設定
PUBSUB_TOPIC_NAME=
PUBSUB_SUBSCRIPTION_NAME=

# Cloud DataStore
FIRESTORE_DATABASE_ID=

# API Server設定
PORT=8080
MAX_FILE_SIZE_MB=20
MAX_TOTAL_SIZE_MB=100

# Worker Server設定
WORKER_PORT=8081
